---
import { ClientRouter } from 'astro:transitions';

interface Props {
  title: string;
  description?: string;
  ogTitle?: string;
  ogDescription?: string;
}

const defaultDescription = 'Web systems, connected infrastructure, sound, and physical making. Client work, independent projects, and technical studies by Montana Stake.';
const { title, description = defaultDescription, ogTitle, ogDescription } = Astro.props;
const normalizedTitle = title.replace(/ — Portfolio$/, '');
const documentTitle = title === 'Portfolio' ? 'Montana Stake — web systems, networks, and experiments' : `${normalizedTitle} — Montana Stake`;
const previewTitle = ogTitle ?? documentTitle;
const previewDescription = ogDescription ?? description;
const siteUrl = Astro.site ?? new URL('https://montanars.com');
const canonicalUrl = new URL(Astro.url.pathname, siteUrl);
const previewImageUrl = new URL('/og.png', siteUrl);
const path = Astro.url.pathname;
const navigation = [
  { href: '/work/web-development/', label: 'Web development' },
  { href: '/work/networking/', label: 'Security + Systems' },
  { href: '/contact/', label: 'Contact' },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta property="og:title" content={previewTitle} />
    <meta property="og:description" content={previewDescription} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:site_name" content="Montana Stake" />
    <meta property="og:image" content={previewImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Montana Stake — web systems, networks, and experiments." />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={previewTitle} />
    <meta name="twitter:description" content={previewDescription} />
    <meta name="twitter:image" content={previewImageUrl} />
    <title>{documentTitle}</title>
    <ClientRouter />
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to content</a>
    <header class="site-header">
      <a href="/" aria-current={path === '/' ? 'page' : undefined}>Montana Stake</a>
      <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="primary-navigation">
        <span class="menu-toggle__icon" aria-hidden="true"><i></i><i></i><i></i></span>
      </button>
      <nav id="primary-navigation" aria-label="Primary navigation">
        {navigation.map((item) => <a href={item.href} aria-current={path.startsWith(item.href) ? 'page' : undefined}>{item.label}</a>)}
      </nav>
    </header>
    <main id="main-content">
      <slot />
    </main>
    <footer class="site-footer">
      <span>Montana Stake / {new Date().getFullYear()}</span>
      <nav aria-label="Footer navigation">
        <a href="/work/web-development/">Web development</a>
        <a href="/work/networking/">Security + Systems</a>
        <a href="/contact/">Contact</a>
        <a href="https://github.com/montana-rs" rel="external">GitHub</a>
      </nav>
    </footer>
  </body>
</html>

<script is:inline>
  const initNavigation = () => {
    const header = document.querySelector('.site-header');
    const toggle = header?.querySelector('.menu-toggle');
    const navigation = header?.querySelector('#primary-navigation');
    if (!header || !toggle || !navigation || toggle.dataset.ready) return;
    toggle.dataset.ready = 'true';
    const setOpen = (open) => {
      header.dataset.menuOpen = open ? 'true' : 'false';
      toggle.setAttribute('aria-expanded', String(open));
      toggle.setAttribute('aria-label', open ? 'Close navigation' : 'Open navigation');
    };
    setOpen(false);
    toggle.addEventListener('click', () => setOpen(header.dataset.menuOpen !== 'true'));
    navigation.addEventListener('click', () => setOpen(false));
    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape') setOpen(false);
    });
  };
  initNavigation();
  document.addEventListener('astro:page-load', initNavigation);
</script>

<style is:global>
  @font-face { font-family: "Archivo"; src: url('/fonts/grotesk.woff2') format('woff2-variations'); font-weight: 100 900; font-stretch: 62% 125%; font-display: swap; }
  @font-face { font-family: "Departure Mono"; src: url('/fonts/mono.woff2') format('woff2'); font-weight: 400; font-display: swap; }
  @font-face { font-family: "JetBrains Mono"; src: url('/fonts/micro.woff2') format('woff2-variations'); font-weight: 100 800; font-display: swap; }
  @font-face { font-family: "Cormorant"; src: url('/fonts/serif.woff2') format('woff2-variations'); font-weight: 300 700; font-display: swap; }
  @font-face { font-family: "UnifrakturMaguntia"; src: url('/fonts/blackletter.woff2') format('woff2'); font-weight: 400; font-display: swap; }
  @font-face { font-family: "Monsieur La Doulaise"; src: url('/fonts/script.woff2') format('woff2'); font-weight: 400; font-display: swap; }
  @font-face { font-family: "W95FA"; src: url('/fonts/pixel.woff2') format('woff2'); font-weight: 400; font-display: swap; }

  :root {
    --earthsong-background: #282420;
    --earthsong-foreground: #e5c6a8;
    --earthsong-cream: #f6f6ec;
    --earthsong-muted: #665e54;
    --earthsong-orange: #ff9168;
    --earthsong-green: #83ef88;
    --earthsong-blue: #5ed9ff;
    --font-grotesk: "Archivo", system-ui, sans-serif;
    --font-mono: "Departure Mono", "JetBrains Mono", ui-monospace, monospace;
    --font-micro: "JetBrains Mono", ui-monospace, monospace;
    --font-serif: "Cormorant", Times, serif;
    --font-blackletter: "UnifrakturMaguntia", serif;
    --font-script: "Monsieur La Doulaise", cursive;
    --font-pixel: "W95FA", "Archivo", system-ui, sans-serif;
    color: #171717;
    color: var(--earthsong-foreground);
    background: var(--earthsong-background);
    color-scheme: dark;
    font-family: var(--font-micro);
    line-height: 1.5;
  }

  * { box-sizing: border-box; }
  body { margin: 0; }
  a { color: var(--earthsong-orange); }
  a:hover { color: var(--earthsong-cream); }
  a:focus-visible, button:focus-visible { outline: 3px solid var(--earthsong-green); outline-offset: 4px; }
  .skip-link { position: fixed; z-index: 10; top: 1rem; left: 1rem; padding: .6rem .8rem; background: var(--earthsong-cream); color: var(--earthsong-background); transform: translateY(-150%); }
  .skip-link:focus { transform: translateY(0); }
  ::selection { color: var(--earthsong-background); background: var(--earthsong-cream); }

  ::view-transition-group(first-known-use-window) {
    animation-duration: 520ms;
    animation-timing-function: cubic-bezier(0.2, 0.8, 0.2, 1);
  }

  ::view-transition-old(first-known-use-window) { animation: window-out 360ms ease both; }
  ::view-transition-new(first-known-use-window) { animation: window-in 520ms cubic-bezier(0.2, 0.8, 0.2, 1) both; }

  @keyframes window-out {
    to { opacity: 0; transform: scale(0.92); }
  }

  @keyframes window-in {
    from { opacity: 0; transform: scale(0.7); }
    to { opacity: 1; transform: scale(1); }
  }

  @media (prefers-reduced-motion: reduce) {
    ::view-transition-old(first-known-use-window),
    ::view-transition-new(first-known-use-window) { animation: none; }
  }

  .site-header {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    padding: 1.25rem clamp(1rem, 4vw, 4rem);
  }

  .site-header nav { display: flex; flex-wrap: wrap; gap: 0.5rem 1rem; }
  .site-header a { font-weight: 700; }
  .menu-toggle { display: none; }
  .site-header [aria-current="page"] { color: var(--earthsong-cream); text-decoration-color: var(--earthsong-orange); text-decoration-thickness: 2px; text-underline-offset: .35em; }
  main { padding: 0 clamp(1rem, 4vw, 4rem) 5rem; }
  .site-footer { display: flex; justify-content: space-between; gap: 1rem 2rem; margin: 4rem clamp(1rem, 4vw, 4rem) 0; padding-block: 1rem; border-top: 1px solid var(--earthsong-muted); color: var(--earthsong-muted); font-size: .78rem; }
  .site-footer nav { display: flex; flex-wrap: wrap; justify-content: flex-end; gap: .4rem 1rem; }
  .site-footer a { color: var(--earthsong-muted); }
  .site-footer a:hover { color: var(--earthsong-cream); }
  @media (max-width: 42rem) {
    .site-header { display: grid; grid-template-columns: 1fr auto; align-items: start; }
    .menu-toggle { display: inline-flex; align-items: center; justify-content: center; justify-self: end; border: 1px solid var(--earthsong-muted); background: transparent; color: var(--earthsong-foreground); padding: .55rem; cursor: pointer; }
    .menu-toggle:hover, .menu-toggle:focus-visible { border-color: var(--earthsong-orange); color: var(--earthsong-cream); }
    .menu-toggle__icon { display: grid; gap: 3px; width: 1rem; }
    .menu-toggle__icon i { display: block; height: 1px; background: currentColor; transition: transform 180ms ease, opacity 180ms ease; }
    .site-header[data-menu-open="true"] .menu-toggle__icon i:first-child { transform: translateY(4px) rotate(45deg); }
    .site-header[data-menu-open="true"] .menu-toggle__icon i:nth-child(2) { opacity: 0; }
    .site-header[data-menu-open="true"] .menu-toggle__icon i:last-child { transform: translateY(-4px) rotate(-45deg); }
    .site-header nav { display: none; grid-column: 1 / -1; flex-direction: column; align-items: flex-end; gap: .55rem; margin-top: .9rem; padding-top: .75rem; border-top: 1px solid var(--earthsong-muted); text-align: right; }
    .site-header[data-menu-open="true"] nav { display: flex; }
    .site-footer { display: block; }
    .site-footer nav { justify-content: flex-start; margin-top: .75rem; }
  }
</style>
