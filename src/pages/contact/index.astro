---
import Base from '../../layouts/Base.astro';
---

<Base title="Contact — Portfolio">
  <article class="contact-page">
    <header class="contact-page__header">
      <p class="eyebrow">Contact / open channel</p>
      <h1>Contact.</h1>
      <p class="contact-page__intro">For client work, collaboration, employment opportunities, or a thoughtful technical conversation, use whichever channel is easiest.</p>
    </header>

    <section class="contact-page__form-section" aria-labelledby="form-title">
      <p class="eyebrow">Direct message</p>
      <h2 id="form-title">Send a note.</h2>
      <form class="contact-page__form" action="mailto:mstake4@gmail.com" method="post" enctype="text/plain">
        <label for="contact-name">Name<input id="contact-name" name="name" autocomplete="name" required /></label>
        <label for="contact-email">Email<input id="contact-email" name="email" type="email" autocomplete="email" required /></label>
        <label for="contact-message">Message<textarea id="contact-message" name="message" rows="6" required></textarea></label>
        <button type="submit">Open email <span aria-hidden="true">→</span></button>
      </form>
    </section>

    <section class="contact-page__channels" aria-labelledby="channels-title">
      <p class="eyebrow">Available channels</p>
      <h2 id="channels-title" class="contact-page__direct-heading">Direct line.</h2>
      <div class="contact-page__list">
        <a href="mailto:mstake4@gmail.com">
          <span>Email</span>
          <strong>mstake4@gmail.com</strong>
          <span aria-hidden="true">↗</span>
        </a>
        <a href="tel:+17408567273">
          <span>Phone</span>
          <strong>(740) 856-7273</strong>
          <span aria-hidden="true">↗</span>
        </a>
        <a href="https://github.com/montana-rs" rel="external">
          <span>Code / GitHub</span>
          <strong>github.com/montana-rs</strong>
          <span aria-hidden="true">↗</span>
        </a>
      </div>
    </section>
  </article>
</Base>

<style>
  .contact-page { max-width: 90rem; min-width: 0; margin-inline: auto; padding-top: clamp(3rem, 10vw, 8rem); }
  .contact-page__header { max-width: 66rem; }
  .eyebrow { font-size: .8rem; letter-spacing: .12em; text-transform: uppercase; }
  h1 { max-width: 12ch; margin-block: 1rem 2rem; font-size: clamp(3.5rem, 11vw, 9rem); line-height: .84; letter-spacing: -.07em; }
  h2 { max-width: 15ch; margin-block: .75rem 2rem; font-size: clamp(2rem, 5vw, 4.5rem); line-height: .95; }
  .contact-page__intro { max-width: 43rem; font-size: clamp(1.2rem, 3vw, 2rem); }
  .contact-page__channels { max-width: 70rem; margin-top: clamp(4rem, 9vw, 7rem); padding-top: 1.25rem; border-top: 1px solid currentColor; }
  .contact-page__direct-heading { max-width: none; margin-block: .75rem .35rem; font-size: clamp(1.3rem, 2.5vw, 2.1rem); line-height: 1; }
  .contact-page__list { border-top: 1px solid currentColor; }
  .contact-page__list a { display: grid; grid-template-columns: minmax(8rem, .35fr) minmax(0, 1fr) auto; gap: 1rem; align-items: baseline; padding: 1.25rem 0; color: var(--earthsong-foreground); border-bottom: 1px solid currentColor; text-decoration: none; }
  .contact-page__list a:hover { color: var(--earthsong-cream); }
  .contact-page__list a > span:first-child { color: var(--earthsong-orange); font-size: .78rem; letter-spacing: .08em; text-transform: uppercase; }
  .contact-page__list strong { font-size: clamp(.82rem, 1.5vw, 1.15rem); font-weight: 400; }
  .contact-page__list a > span:last-child { color: var(--earthsong-orange); font-size: 1.4rem; }
  .contact-page__form-section { max-width: 44rem; margin-top: clamp(5rem, 10vw, 8rem); padding-top: 1.25rem; border-top: 1px solid currentColor; }
  .contact-page__form { display: grid; gap: 1rem; }
  .contact-page__form label { display: grid; gap: .45rem; color: var(--earthsong-orange); font-size: .78rem; letter-spacing: .08em; text-transform: uppercase; }
  .contact-page__form input, .contact-page__form textarea { width: 100%; border: 1px solid var(--earthsong-muted); border-radius: 0; background: var(--earthsong-background); color: var(--earthsong-foreground); padding: .75rem; font: inherit; letter-spacing: normal; text-transform: none; }
  .contact-page__form input:focus, .contact-page__form textarea:focus { border-color: var(--earthsong-green); outline: 2px solid var(--earthsong-green); outline-offset: 2px; }
  .contact-page__form textarea { resize: vertical; }
  .contact-page__form button { justify-self: start; border: 1px solid var(--earthsong-orange); border-radius: 0; background: transparent; color: var(--earthsong-orange); padding: .75rem 1rem; font: inherit; cursor: pointer; }
  .contact-page__form button:hover, .contact-page__form button:focus-visible { background: var(--earthsong-orange); color: var(--earthsong-background); }
  @media (max-width: 42rem) { .contact-page__list a { grid-template-columns: 1fr auto; gap: .4rem 1rem; } .contact-page__list a > span:first-child { grid-column: 1 / -1; } }
</style>
