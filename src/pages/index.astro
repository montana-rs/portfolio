---
import Base from '../layouts/Base.astro';
---

<Base title="Portfolio">
  <section class="home-intro" aria-labelledby="home-title">
    <p class="eyebrow">Work in progress</p>
    <h1 id="home-title">A portfolio for work that can change shape.</h1>
    <p>This is the first small slice: one project, one experiment, and room for the rest to become itself.</p>
    <a href="/work/web-development/first-known-use">See First Known Use</a>
  </section>
</Base>

<style>
  .home-intro { max-width: 58rem; padding-top: clamp(4rem, 15vw, 12rem); }
  .eyebrow { font-size: 0.8rem; letter-spacing: 0.12em; text-transform: uppercase; }
  h1 { max-width: 11ch; margin-block: 1rem 2rem; font-size: clamp(3rem, 12vw, 9rem); line-height: 0.88; }
  p:not(.eyebrow) { max-width: 34rem; }
</style>
