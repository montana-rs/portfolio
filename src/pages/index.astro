---
import Base from '../layouts/Base.astro';
---

<Base title="Portfolio">
  <section class="home-intro" aria-labelledby="home-title">
    <p class="eyebrow">Portfolio / selected work</p>
    <h1 id="home-title">I build web experiences and systems that are useful, understandable, and worth returning to.</h1>
    <div class="home-intro__actions" aria-label="Primary actions">
      <a class="home-intro__cta" href="#featured-work">View work <span aria-hidden="true">→</span></a>
      <a class="home-intro__cta" href="/contact/">Contact <span aria-hidden="true">→</span></a>
    </div>
  </section>

  <section class="featured-work" id="featured-work" aria-labelledby="featured-title">
    <div>
      <p class="eyebrow">Selected work</p>
      <h2 id="featured-title">Clear work. Strange edges.</h2>
    </div>
    <div class="featured-work__list">
      <a href="/work/web-development/first-known-use">
        <span>01 / music identity + web experience</span>
        <strong>First Known Use</strong>
        <p>Websites and digital experiences for people building something with its own character. A living archive for a Vermont music project: identity, releases, lyrics, images, and digital detours.</p>
      </a>
      <a href="/work/networking/">
        <span>02 / security + infrastructure</span>
        <strong>Security + Systems</strong>
        <p>Security-minded systems work, infrastructure, and hands-on technical practice for employers and technical teams.</p>
      </a>
    </div>
  </section>
</Base>

<style>
  .home-intro { max-width: 66rem; padding-top: clamp(4rem, 15vw, 12rem); }
  .eyebrow { font-size: 0.8rem; letter-spacing: 0.12em; text-transform: uppercase; }
  h1 { max-width: 13ch; margin-block: 1rem 2rem; font-size: clamp(3rem, 8vw, 7.2rem); line-height: .88; letter-spacing: -.06em; }
  .home-intro > p:not(.eyebrow) { max-width: 43rem; font-size: clamp(1.15rem, 2.5vw, 1.65rem); }
  .home-intro__cta { display: inline-block; margin-top: 1rem; font-weight: 700; }
  .featured-work { display: grid; grid-template-columns: minmax(12rem, .7fr) minmax(0, 1.3fr); gap: clamp(2rem, 8vw, 8rem); max-width: 76rem; margin-top: clamp(6rem, 16vw, 14rem); }
  h2 { max-width: 10ch; margin: .75rem 0 0; font-size: clamp(2rem, 5vw, 4rem); line-height: .95; }
  .featured-work__list { border-top: 1px solid currentColor; }
  .featured-work__list a { display: grid; gap: .7rem; padding: 1.25rem 0 1.5rem; color: var(--earthsong-foreground); border-bottom: 1px solid currentColor; text-decoration: none; }
  .featured-work__list a:hover { color: var(--earthsong-cream); }
  .featured-work__list a > span, .featured-work__list a > strong, .featured-work__list a > p { display: block; }
  .featured-work__list span { color: var(--earthsong-orange); font-size: .75rem; letter-spacing: .09em; text-transform: uppercase; }
  .featured-work__list strong { color: var(--earthsong-foreground); font-size: clamp(1.8rem, 4vw, 3.5rem); font-weight: 400; line-height: .9; text-decoration: none; }
  .featured-work__list p { max-width: 38rem; margin: 0; }
  @media (max-width: 42rem) { .featured-work { display: block; } .featured-work__list { margin-top: 2rem; } }
</style>
