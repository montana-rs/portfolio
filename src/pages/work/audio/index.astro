---
import Base from '../../../layouts/Base.astro';
---

<Base title="Audio — Portfolio">
  <section class="section-page" aria-labelledby="section-title">
    <p class="eyebrow">Section / audio</p>
    <h1 id="section-title">Audio</h1>
    <p>Projects in sound, recording, composition, and listening.</p>
    <p class="section-page__empty">Projects will live here as they become ready to share.</p>
  </section>
</Base>

<style>
  .section-page { max-width: 58rem; padding-top: clamp(4rem, 14vw, 11rem); }
  .eyebrow { font-size: 0.8rem; letter-spacing: 0.12em; text-transform: uppercase; }
  h1 { margin-block: 1rem 2rem; font-size: clamp(3.5rem, 14vw, 11rem); line-height: 0.85; }
  .section-page > p:not(.eyebrow) { max-width: 38rem; font-size: clamp(1.2rem, 3vw, 2rem); }
  .section-page__empty { margin-top: 5rem; font-size: 1rem !important; }
</style>
