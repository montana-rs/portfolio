            <path class="trust-map__branch-signal trust-map__branch-signal--halo" d="M 300 150 V 224 H 410" pathLength="100" />
            <path class="trust-map__branch-signal trust-map__branch-signal--bloom" d="M 300 150 V 224 H 410" pathLength="100" />
            <path class="trust-map__branch-signal trust-map__branch-signal--core" d="M 300 150 V 224 H 410" pathLength="100" />
            <path class="trust-map__branch-signal trust-map__branch-signal--halo" d="M 300 150 V 88 H 410" pathLength="100" />
            <path class="trust-map__branch-signal trust-map__branch-signal--bloom" d="M 300 150 V 88 H 410" pathLength="100" />
            <path class="trust-map__branch-signal trust-map__branch-signal--core" d="M 300 150 V 88 H 410" pathLength="100" />
            <path class="trust-map__route" d="M 82 150 H 190 H 300 H 500 H 650" />
            <path class="trust-map__route trust-map__route--branch" d="M 300 150 V 224 H 410" />
            <path class="trust-map__route trust-map__route--branch" d="M 300 150 V 88 H 410" />
            <g class="trust-map__node trust-map__node--external" data-trust-node="0" transform="translate(82 150)">
              <circle r="17" /><circle class="trust-map__dot" r="4" /><text x="0" y="-30" text-anchor="middle">REMOTE DEVICE</text>
            </g>
            <g class="trust-map__node trust-map__node--access" data-trust-node="0.199" transform="translate(190 150)">
              <circle r="17" /><circle class="trust-map__dot" r="4" /><text x="0" y="-30" text-anchor="middle">MESH ACCESS</text>
            </g>
            <g class="trust-map__node" data-trust-node="0.401" transform="translate(300 150)">
