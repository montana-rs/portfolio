<script>
  const initTrustMap = () => {
    const map = document.querySelector('[data-trust-map]');
    const signals = [...document.querySelectorAll('.trust-map__signal')];
    const branchSignals = [...document.querySelectorAll('.trust-map__branch-signal')];
    const nodes = [...document.querySelectorAll('[data-trust-node]')];
    const branchNodes = [...document.querySelectorAll('[data-trust-branch]')];
    if (!map || signals.length === 0 || branchSignals.length === 0 || nodes.length === 0 || branchNodes.length === 0) return;

    const scope = window;
    scope.__trustMapCleanup?.();
    const travelDuration = 7000;
    const checkpointProgress = 0.384;
    const checkpointPause = 1200;
    const checkpointTravel = travelDuration * checkpointProgress;
    const remainingTravel = travelDuration * (1 - checkpointProgress);
    const activeDuration = checkpointTravel + checkpointPause + remainingTravel;
    const restartPause = 900;
    const cycleDuration = activeDuration + restartPause;
    const receiverHalfWindow = 0.075;
    let frameId;
    let start;

    const setSignalPosition = (signal, progress) => {
      const halfLength = signal.classList.contains('trust-map__signal--halo') || signal.classList.contains('trust-map__branch-signal--halo') ? 0.035 : 0.055;
      signal.style.strokeDashoffset = `${-(progress - halfLength) * 100}`;
    };

    const update = (progress, branchProgress, holding = false) => {
      signals.forEach((signal) => {
        setSignalPosition(signal, progress);
      });
      branchSignals.forEach((signal) => {
        setSignalPosition(signal, branchProgress);
        signal.style.opacity = branchProgress <= 0 ? '0' : '';
      });
      branchNodes.forEach((branchNode) => {
        branchNode.classList.toggle('is-active', !holding && branchProgress > 0.87);
      });
      nodes.forEach((node) => {
        const target = Number(node.dataset.trustNode);
        const isFirst = target === 0;
        const isLast = target === 1;
        const isInWindow = isFirst
          ? progress < receiverHalfWindow * 2 + 0.01
          : isLast
            ? progress > 1 - receiverHalfWindow * 2 + 0.02
            : Math.abs(progress - target) < receiverHalfWindow;
        node.classList.toggle('is-active', !holding && isInWindow);
      });
    };

    const tick = (now) => {
      if (start === undefined) start = now;
      const elapsed = (now - start) % cycleDuration;
      const isHolding = elapsed >= activeDuration;
      let progress;
      let branchProgress;
      if (elapsed < checkpointTravel) {
        progress = elapsed / travelDuration;
        branchProgress = 0;
      } else if (elapsed < checkpointTravel + checkpointPause) {
        progress = checkpointProgress;
        branchProgress = Math.min((elapsed - checkpointTravel) / (checkpointPause * 0.8), 1);
      } else {
        progress = checkpointProgress + ((Math.min(elapsed, activeDuration) - checkpointTravel - checkpointPause) / remainingTravel) * (1 - checkpointProgress);
        branchProgress = 1;
      }
      update(progress, branchProgress, isHolding);
      frameId = requestAnimationFrame(tick);
    };

    const cleanup = () => {
      cancelAnimationFrame(frameId);
      nodes.forEach((node) => node.classList.remove('is-active'));
      branchNodes.forEach((node) => node.classList.remove('is-active'));
      delete scope.__trustMapCleanup;
    };
    scope.__trustMapCleanup = cleanup;

    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
      update(0, 0);
      return;
    }
    frameId = requestAnimationFrame(tick);
  };

  document.addEventListener('astro:page-load', initTrustMap);
  initTrustMap();
</script>

<script>
  const initLabSystemMap = () => {
    const signals = [...document.querySelectorAll('.lab-system-map__signal')];
    const nodes = [...document.querySelectorAll('[data-loop-node]')];
    const recoverNodes = [...document.querySelectorAll('[data-recover-node]')];
    if (signals.length === 0 || nodes.length === 0 || recoverNodes.length === 0) return;

    const scope = window;
    scope.__labSystemMapCleanup?.();
    const duration = 8000;
    const restartPause = 0;
    const cycleDuration = duration + restartPause;
    const receiverHalfWindow = 0.065;
    let frameId;
    let start;

    const setSignalPosition = (signal, phase) => {
      const isMobile = signal.closest('.lab-system-map__svg--mobile');
      const pathProgress = !isMobile && signal.classList.contains('lab-system-map__signal--provenance')
        ? (phase + 0.5) % 1
        : phase;
      let halfLength = 0.03;
      if (signal.classList.contains('lab-system-map__signal--trail')) halfLength = 0.08;
      if (signal.classList.contains('lab-system-map__signal--halo')) halfLength = 0.05;
      if (signal.classList.contains('lab-system-map__signal--core')) halfLength = 0.025;
      signal.style.strokeDashoffset = `${-(pathProgress - halfLength) * 100}`;
    };

    const update = (phase, holding = false) => {
      signals.forEach((signal) => setSignalPosition(signal, phase));
      nodes.forEach((node) => {
        const nodePhase = Number(node.dataset.nodePhase);
        const loopPhase = node.dataset.loopNode === 'provenance' ? phase : phase;
        const distance = Math.abs(loopPhase - nodePhase);
        const isActive = distance < receiverHalfWindow || distance > 1 - receiverHalfWindow;
        node.classList.toggle('is-active', !holding && isActive);
      });
      recoverNodes.forEach((node) => node.classList.toggle('is-active', !holding && (phase < receiverHalfWindow || phase > 1 - receiverHalfWindow)));
    };

    const tick = (now) => {
      if (start === undefined) start = now;
      const elapsed = (now - start) % cycleDuration;
      const holding = elapsed >= duration;
      update(holding ? 0 : elapsed / duration, holding);
      frameId = requestAnimationFrame(tick);
    };

    const cleanup = () => {
      cancelAnimationFrame(frameId);
      nodes.forEach((node) => node.classList.remove('is-active'));
      recoverNodes.forEach((node) => node.classList.remove('is-active'));
      delete scope.__labSystemMapCleanup;
    };
    scope.__labSystemMapCleanup = cleanup;

    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
      update(0);
      return;
    }
    frameId = requestAnimationFrame(tick);
  };

  document.addEventListener('astro:page-load', initLabSystemMap);
  initLabSystemMap();
</script>

