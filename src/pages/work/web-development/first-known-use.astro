---
import Base from '../../../layouts/Base.astro';
---

<Base title="First Known Use — Portfolio" theme="fku-light">
  <article class="fku-tour">
    <svg width="0" height="0" style="position: absolute;" aria-hidden="true">
      <filter id="fku-xerox-text" x="-20%" y="-20%" width="140%" height="140%">
        <feTurbulence type="fractalNoise" baseFrequency="0.9" numOctaves="2" seed="7" result="noise" />
        <feDisplacementMap in="SourceGraphic" in2="noise" scale="3.2" xChannelSelector="R" yChannelSelector="G" />
      </filter>
    </svg>

    <div class="fku-tour__stage">
      <span class="fku-tour__doodle fku-tour__doodle--1" style={`--fku-doodle-url: url(/fku-tour/doodles/sparkle.svg)`} aria-hidden="true"></span>
      <span class="fku-tour__doodle fku-tour__doodle--2" style={`--fku-doodle-url: url(/fku-tour/doodles/sparkle-1.svg)`} aria-hidden="true"></span>
      <span class="fku-tour__doodle fku-tour__doodle--3" style={`--fku-doodle-url: url(/fku-tour/doodles/sparkle-2.svg)`} aria-hidden="true"></span>
      <span class="fku-tour__doodle fku-tour__doodle--4" style={`--fku-doodle-url: url(/fku-tour/doodles/sparkle.svg)`} aria-hidden="true"></span>

      <header class="fku-tour__header">
        <p class="fku-tour__eyebrow">Project / First Known Use</p>
        <h1 class="fku-tour__crush">
          <span class="fku-tour__word fku-tour__word--1">First</span>
          <span class="fku-tour__word fku-tour__word--2">Known</span>
          <span class="fku-tour__word fku-tour__word--3">Use</span>
        </h1>
        <p><a href="https://firstknownuse.com/" rel="external">Visit the live site &#8599;</a></p>
      </header>

      <section class="fku-tour__window" aria-label="Live view of the First Known Use website">
        <img class="fku-tour__gif fku-tour__gif--1" src="/fku-tour/gifs/fish.gif" alt="" aria-hidden="true" loading="lazy" />
        <img class="fku-tour__gif fku-tour__gif--2" src="/fku-tour/gifs/cat.gif" alt="" aria-hidden="true" loading="lazy" />
        <img class="fku-tour__gif fku-tour__gif--3" src="/fku-tour/gifs/headphones.gif" alt="" aria-hidden="true" loading="lazy" />
        <img class="fku-tour__gif fku-tour__gif--4" src="/fku-tour/gifs/bug.gif" alt="" aria-hidden="true" loading="lazy" />
        <div class="fku-tour__frame">
          <div class="fku-tour__bezel">
            <span class="fku-tour__bumper fku-tour__bumper--tl" aria-hidden="true"></span>
            <span class="fku-tour__bumper fku-tour__bumper--tr" aria-hidden="true"></span>
            <span class="fku-tour__bumper fku-tour__bumper--bl" aria-hidden="true"></span>
            <span class="fku-tour__bumper fku-tour__bumper--br" aria-hidden="true"></span>
            <span class="fku-tour__tally" aria-hidden="true"></span>
            <div class="fku-tour__screen-frame">
              <iframe
                src="https://firstknownuse.com/"
                title="Live, scrollable view of the First Known Use website"
                loading="lazy"
                referrerpolicy="strict-origin-when-cross-origin"
              ></iframe>
            </div>
          </div>
        </div>
      </section>

      <div class="fku-tour__marquee" aria-hidden="true">
        <div class="fku-tour__marquee-track">
          <div class="fku-tour__marquee-group">
            {Array.from({ length: 16 }).map(() => (
              <span class="fku-tour__marquee-item">First Known Use <span class="fku-tour__spot">&#9733;</span></span>
            ))}
          </div>
          <div class="fku-tour__marquee-group">
            {Array.from({ length: 16 }).map(() => (
              <span class="fku-tour__marquee-item">First Known Use <span class="fku-tour__spot">&#9733;</span></span>
            ))}
          </div>
        </div>
        <p class="fku-tour__marquee-static"><span class="fku-tour__spot">&#9733;</span> First Known Use <span class="fku-tour__spot">&#9733;</span></p>
      </div>
    </div>

    <section class="fku-tour__details">
      <span class="fku-tour__sr-only">The build</span>
      <dl>
        <div><dt>Contribution</dt><dd>Design, development, and architecture</dd></div>
        <div><dt>External project stack</dt><dd>Astro, TypeScript, TinaCMS, and Cloudflare</dd></div>
      </dl>
    </section>
  </article>
</Base>

<style>
  @font-face { font-family: "Big Shoulders Display"; src: url('/fonts/big-shoulders-display-900.woff2') format('woff2'); font-weight: 900; font-display: swap; }
  @font-face { font-family: "Newsreader"; src: url('/fonts/newsreader-400.woff2') format('woff2'); font-weight: 400; font-style: normal; font-display: swap; }
  @font-face { font-family: "Newsreader"; src: url('/fonts/newsreader-400-italic.woff2') format('woff2'); font-weight: 400; font-style: italic; font-display: swap; }
  .fku-tour {
    --fku-ink: #0a0a0a;
    --fku-paper: #fdfdfb;
    --fku-spot: #ff6a1a;
    --fku-bezel-cream: #e6e0d2;
    --fku-bezel-cream-dark: #c9c1ac;
    --fku-bezel-rubber: #1c1a17;
    --fku-headline: 'Big Shoulders Display', 'Arial Narrow', 'Helvetica Neue', Impact, sans-serif;
    --fku-serif: 'Newsreader', Georgia, 'Times New Roman', serif;
    --fku-mono: 'Courier New', monospace;
    min-width: 0;
    margin: clamp(3rem, 10vw, 8rem) calc(-1 * clamp(1rem, 4vw, 4rem)) 0;
    padding: clamp(2rem, 6vw, 4rem) clamp(1rem, 4vw, 4rem) clamp(4rem, 10vw, 7rem);
    background: var(--fku-paper);
    color: var(--fku-ink);
    color-scheme: light;
    font-family: var(--fku-serif);
    line-height: 1.5;
  }
  .fku-tour a { color: var(--fku-ink); font-weight: 400; text-decoration-thickness: 1.5px; }
  .fku-tour a:hover, .fku-tour a:focus-visible { background: var(--fku-spot); color: var(--fku-ink); text-decoration: none; }
  .fku-tour ::selection { background: var(--fku-spot); color: var(--fku-ink); }
  .fku-tour__sr-only { position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip: rect(0, 0, 0, 0); white-space: nowrap; border: 0; }

  .fku-tour__stage { position: relative; max-width: 72rem; margin-inline: auto; }
  .fku-tour__eyebrow { margin: 0; font-family: var(--fku-mono); font-size: 0.8rem; letter-spacing: 0.1em; text-transform: uppercase; }
  .fku-tour__header { position: relative; z-index: 2; max-width: 64rem; margin-inline: auto; }
  .fku-tour__header p a { font-family: var(--fku-mono); }

  .fku-tour__crush {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0 0.15em;
    margin: 1rem 0 0;
    font-family: var(--fku-headline);
    font-weight: 900;
    text-transform: uppercase;
    letter-spacing: -0.035em;
    line-height: 0.85;
  }
  .fku-tour__word { display: inline-block; font-size: clamp(3.25rem, 12vw, 9rem); filter: url(#fku-xerox-text); }
  .fku-tour__word--2 { font-size: clamp(2.6rem, 9.8vw, 7.4rem); }
  .fku-tour__word--3 { font-size: clamp(3.6rem, 13vw, 9.7rem); margin-inline-start: -0.06em; }
  @media (prefers-reduced-motion: no-preference) {
    .fku-tour__word--2 { transform: rotate(-3deg); }
    .fku-tour__word--3 { transform: rotate(2deg); }
  }

  .fku-tour__window { position: relative; z-index: 2; margin-top: clamp(2.5rem, 7vw, 5rem); }
  .fku-tour__frame { max-width: 62rem; margin-inline: auto; }

  /* Field recorder bezel: rubber corner bumpers, a carry strap, one tally light */
  .fku-tour__bezel {
    position: relative;
    background: linear-gradient(165deg, var(--fku-bezel-cream), var(--fku-bezel-cream-dark) 85%);
    border-radius: 0.9rem;
    padding: clamp(0.6rem, 1.6vw, 1rem);
    box-shadow: 0 1px 0 rgba(255,255,255,0.5) inset, 0 12px 26px rgba(0,0,0,0.28);
  }
  .fku-tour__screen-frame {
    border-radius: 0.4rem;
    padding: clamp(0.35rem, 1vw, 0.6rem);
    background: #0a0a0a;
    box-shadow: 0 0 0 1px rgba(0,0,0,0.4), 0 2px 8px rgba(0,0,0,0.55) inset;
  }
  .fku-tour__screen-frame iframe { display: block; width: 100%; height: clamp(24rem, 60vw, 40rem); border: 0; border-radius: 0.15rem; background: var(--fku-paper); }
  .fku-tour__bumper { position: absolute; width: clamp(1.1rem, 2.4vw, 1.5rem); height: clamp(1.1rem, 2.4vw, 1.5rem); background: var(--fku-bezel-rubber); border-radius: 0.35rem; z-index: 1; }
  .fku-tour__bumper--tl { top: -0.2rem; left: -0.2rem; }
  .fku-tour__bumper--tr { top: -0.2rem; right: -0.2rem; }
  .fku-tour__bumper--bl { bottom: -0.2rem; left: -0.2rem; }
  .fku-tour__bumper--br { bottom: -0.2rem; right: -0.2rem; }
  .fku-tour__tally {
    position: absolute;
    top: 0.55rem;
    right: 0.6rem;
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 50%;
    background: var(--fku-spot);
    box-shadow: 0 0 6px var(--fku-spot), 0 0 12px color-mix(in srgb, var(--fku-spot) 60%, transparent);
    z-index: 1;
    animation: fku-tally-flicker 7.4s ease-in-out infinite;
  }
  @keyframes fku-tally-flicker {
    0%, 100% { opacity: 1; }
    3% { opacity: 1; }
    4% { opacity: 0.25; }
    5% { opacity: 1; }
    6% { opacity: 0.15; }
    8% { opacity: 1; }
    31% { opacity: 1; }
    33% { opacity: 0.45; }
    35% { opacity: 1; }
    58% { opacity: 1; }
    60% { opacity: 0.2; }
    61% { opacity: 0.75; }
    63% { opacity: 1; }
    86% { opacity: 1; }
    88% { opacity: 0.35; }
    90% { opacity: 1; }
  }
  @media (prefers-reduced-motion: reduce) {
    .fku-tour__tally { animation: none; }
  }

  .fku-tour__marquee { position: relative; z-index: 2; overflow: hidden; max-width: 62rem; margin: 1.5rem auto 0; padding-block: 0.6rem; border-block: 1.5px solid var(--fku-ink); }
  .fku-tour__marquee-track { display: flex; width: max-content; animation: fku-marquee-scroll 32s steps(100, end) infinite; }
  .fku-tour__marquee-group { display: flex; flex-shrink: 0; }
  .fku-tour__marquee-item { font-family: var(--fku-headline); font-size: clamp(1.1rem, 3.4vw, 1.8rem); text-transform: uppercase; white-space: nowrap; padding-inline-end: 1.5rem; filter: url(#fku-xerox-text); }
  .fku-tour__spot { color: var(--fku-spot); }
  .fku-tour__marquee-static { display: none; margin: 0; text-align: center; font-family: var(--fku-headline); font-size: clamp(1.1rem, 3.4vw, 1.8rem); text-transform: uppercase; filter: url(#fku-xerox-text); }
  @keyframes fku-marquee-scroll {
    from { transform: translateX(0); }
    to { transform: translateX(-50%); }
  }
  @media (prefers-reduced-motion: reduce) {
    .fku-tour__marquee-track { display: none; }
    .fku-tour__marquee-static { display: block; }
  }

  .fku-tour__doodle {
    position: absolute;
    z-index: 1;
    width: 2rem;
    height: 2rem;
    background-color: var(--fku-spot);
    -webkit-mask-image: var(--fku-doodle-url);
    mask-image: var(--fku-doodle-url);
    -webkit-mask-position: center;
    mask-position: center;
    -webkit-mask-repeat: no-repeat;
    mask-repeat: no-repeat;
    -webkit-mask-size: contain;
    mask-size: contain;
  }
  .fku-tour__doodle--1 { top: -1.5rem; left: 42%; transform: rotate(-8deg); }
  .fku-tour__doodle--2 { top: 8%; right: 1%; transform: rotate(10deg); }
  .fku-tour__doodle--3 { top: 60%; left: 0.5%; transform: rotate(6deg); }
  .fku-tour__doodle--4 { bottom: -1rem; right: 8%; transform: rotate(-12deg); }
  @media (prefers-reduced-motion: no-preference) {
    .fku-tour__doodle { animation: fku-doodle-bob 2.6s steps(6) infinite; }
  }
  @keyframes fku-doodle-bob {
    0%, 100% { translate: 0 0; }
    50% { translate: 0 -3px; }
  }

  /* Positioned relative to .fku-tour__window (which spans the full stage width),
     so they land in the gutter beside the centered 62rem TV frame — never
     underneath it or the title above. Shown only where that gutter reliably
     exists (see min-width query below). */
  .fku-tour__gif { position: absolute; z-index: 1; width: clamp(3rem, 4vw, 4rem); height: auto; filter: drop-shadow(0 2px 4px rgba(0,0,0,0.25)); display: none; }
  .fku-tour__gif--1 { top: 6%; left: 0.5rem; transform: rotate(-9deg); }
  .fku-tour__gif--2 { top: 55%; right: 0.5rem; transform: rotate(11deg); }
  .fku-tour__gif--3 { top: 82%; left: 0.5rem; transform: rotate(7deg); }
  .fku-tour__gif--4 { top: 30%; right: 0.5rem; transform: rotate(-6deg); }
  @media (min-width: 80rem) {
    .fku-tour__gif { display: block; }
  }

  .fku-tour__details { max-width: 48rem; margin: clamp(4rem, 10vw, 7rem) auto 0; }
  .fku-tour__details dl { margin: 0; }
  .fku-tour__details div { border-top: 1px solid var(--fku-ink); padding-block: 1rem; }
  .fku-tour__details div:last-child { border-bottom: 1px solid var(--fku-ink); }
  .fku-tour__details dt { font-family: var(--fku-mono); font-size: 0.78rem; letter-spacing: 0.1em; text-transform: uppercase; }
  .fku-tour__details dd { margin: 0.35rem 0 0; }

  @media (max-width: 42rem) {
    .fku-tour__word { font-size: clamp(2.5rem, 15vw, 4.5rem); }
    .fku-tour__word--2 { font-size: clamp(2rem, 12vw, 3.7rem); }
    .fku-tour__word--3 { font-size: clamp(2.7rem, 16vw, 4.8rem); }
    .fku-tour__doodle, .fku-tour__gif { display: none; }
  }
</style>
