---
import Base from '../../../../layouts/Base.astro';
import ProofSheetArtifact from '../../../../sections/web-development/ProofSheetArtifact.astro';
---

<Base title="Proof Sheet — Portfolio">
  <article class="experiment">
    <header class="experiment__header">
      <p class="eyebrow">Web development / browser experiment</p>
      <h1 aria-label="[ PROVENANCE / 00 ] PROOF SHEET">
        <span class="experiment__stamp"><span data-page-stamp aria-hidden="true"></span><span class="experiment__cursor" data-stamp-cursor aria-hidden="true"></span></span>
        <span class="experiment__title-line"><span data-page-title aria-hidden="true"></span><span class="experiment__cursor is-hidden" data-title-cursor aria-hidden="true"></span></span>
      </h1>
      <p class="experiment__summary">
        A warm-up consumable for PROVENANCE: <br> one image in, one 2000px proof sheet out. <br> Image processing stays
        in the browser. OWLv2 model weights download remotely on first use.
      </p>
    </header>

    <ProofSheetArtifact />

    <section class="signal" aria-label="Proof Sheet project summary">
      <p>LOCAL IMAGE</p>
      <span aria-hidden="true">→</span>
      <p>COMPOSITION</p>
      <span aria-hidden="true">→</span>
      <p>PROOF SHEET</p>
    </section>

    <section class="details" aria-labelledby="details-title">
      <div>
        <p class="eyebrow">The project</p>
        <h2 id="details-title">A local machine for making visual evidence strange.</h2>
        <p>
          Proof Sheet turns an uploaded, dropped, or pasted image into a deliberately official-looking document.
          It combines image treatment, object-region callouts, poetic misclassification, grain, typography, and a
          deterministic seed into one repeatable poster flow.
        </p>
      </div>

      <dl class="details__list">
        <div>
          <dt>Input</dt>
          <dd>One image, selected locally, dropped, or pasted</dd>
        </div>
        <div>
          <dt>Output</dt>
          <dd>Downloadable 2000px PNG proof sheet</dd>
        </div>
        <div>
          <dt>Runtime</dt>
          <dd>Client-side TypeScript, Canvas, a Web Worker, Transformers.js, and optional WebGPU/WASM inference</dd>
        </div>
        <div>
          <dt>Fallback</dt>
          <dd>Deterministic local geometry when model inference is unavailable</dd>
        </div>
      </dl>
    </section>

    <section class="pipeline" aria-labelledby="pipeline-title">
      <p class="eyebrow">Pipeline</p>
      <h2 id="pipeline-title">The browser is the studio.</h2>
      <ol>
        <li>
          <h3>Mask</h3>
          <p>A local image is reduced to a working canvas and given a lightweight local background treatment.</p>
        </li>
        <li>
          <h3>Read</h3>
          <p>OWLv2 queries visual regions in a worker through WebGPU or WASM, with a deterministic geometry fallback.</p>
        </li>
        <li>
          <h3>Compose</h3>
          <p>Dither, callouts, grain, labels, and a seeded barcode are composed into the final proof sheet.</p>
        </li>
      </ol>
    </section>

    <section class="data-boundary" aria-labelledby="data-boundary-title">
      <div>
        <p class="eyebrow">Data boundary</p>
        <h2 id="data-boundary-title">The image stays close.</h2>
      </div>
      <div class="data-boundary__copy">
        <p>The selected image is read by the browser and is not uploaded by this tool. The image treatment, dither, composition, and final PNG are produced locally.</p>
        <dl>
          <div><dt>Remote request</dt><dd>OWLv2 model weights download from the configured Transformers.js model source on first use.</dd></div>
          <div><dt>Local execution</dt><dd>WebGPU or WASM performs inference in a Web Worker when the browser supports it.</dd></div>
          <div><dt>Fallback</dt><dd>If the model cannot initialize, the tool returns to deterministic local geometry rather than blocking the composition.</dd></div>
          <div><dt>Telemetry</dt><dd>The portfolio code does not intentionally send the selected image to an analytics or application server.</dd></div>
        </dl>
      </div>
    </section>
  </article>
</Base>

<script>
  const initPageTitle = () => {
    const stamp = document.querySelector<HTMLElement>('[data-page-stamp]');
    const title = document.querySelector<HTMLElement>('[data-page-title]');
    const stampCursor = document.querySelector<HTMLElement>('[data-stamp-cursor]');
    const titleCursor = document.querySelector<HTMLElement>('[data-title-cursor]');
    if (!stamp || !title || !stampCursor || !titleCursor || stamp.dataset.ready) return;
    stamp.dataset.ready = 'true';
    const stampText = '[ PROVENANCE / 00 ]';
    const titleText = 'PROOF SHEET';
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
      stamp.textContent = stampText;
      title.textContent = titleText;
      stampCursor.classList.add('is-hidden');
      titleCursor.classList.remove('is-hidden');
      return;
    }
    window.setTimeout(() => {
      const type = (target: HTMLElement, text: string, done: () => void) => {
        let index = 0;
        const typeNext = () => {
          target.textContent = text.slice(0, index);
          index += 1;
          if (index <= text.length) window.setTimeout(typeNext, 90);
          else done();
        };
        typeNext();
      };
      type(stamp, stampText, () => {
        window.setTimeout(() => {
          stampCursor.classList.add('is-hidden');
          titleCursor.classList.remove('is-hidden');
          type(title, titleText, () => undefined);
        }, 180);
      });
    }, 420);
  };
  initPageTitle();
  document.addEventListener('astro:page-load', initPageTitle);
</script>

<style>
  .experiment { max-width: 90rem; min-width: 0; margin-inline: auto; padding-top: clamp(3rem, 10vw, 8rem); }
  .experiment__header { max-width: 64rem; }
  .eyebrow { font-size: 0.8rem; letter-spacing: 0.12em; text-transform: uppercase; }
  h1 { display: flex; flex-direction: column; align-items: flex-start; margin-block: 1rem; font-size: clamp(3rem, 8vw, 7rem); line-height: 0.85; letter-spacing: -0.07em; font-weight: 400; }
  .experiment__stamp { display: inline-flex; align-items: baseline; margin-bottom: 0.7em; color: var(--earthsong-orange); font-size: 0.18em; line-height: 1; letter-spacing: 0.08em; }
  .experiment__title-line { display: inline-flex; align-items: baseline; }
  .experiment__cursor { display: inline-block; width: .55ch; height: .78em; margin-left: .14ch; vertical-align: -.04em; background: currentColor; animation: page-title-cursor 1s steps(1, end) infinite; }
  .experiment__cursor.is-hidden { display: none; }
  @keyframes page-title-cursor { 50% { opacity: 0; } }
  .experiment__summary { max-width: 43rem; font-size: clamp(1.25rem, 3vw, 2rem); }
  .signal { display: flex; align-items: center; justify-content: space-between; gap: 1rem; max-width: 70rem; margin-top: clamp(4rem, 10vw, 9rem); padding-block: 1.25rem; border-block: 1px solid currentColor; font-size: clamp(0.75rem, 2vw, 1rem); letter-spacing: 0.08em; }
  .signal p { margin: 0; }
  .signal span { color: var(--earthsong-orange); font-size: 1.5rem; }
  .details, .pipeline { margin-top: clamp(5rem, 12vw, 10rem); }
  .details { display: grid; grid-template-columns: minmax(0, 1fr) minmax(16rem, 0.7fr); gap: clamp(2rem, 8vw, 8rem); }
  .details > div { max-width: 42rem; }
  h2 { max-width: 15ch; margin-block: 0.75rem 1.5rem; font-size: clamp(2.25rem, 6vw, 5.5rem); line-height: 0.95; }
  .details__list { margin: 0; }
  .details__list div { padding-block: 1rem; border-top: 1px solid currentColor; }
  .details__list div:last-child { border-bottom: 1px solid currentColor; }
  .details__list dt { font-size: 0.8rem; letter-spacing: 0.1em; text-transform: uppercase; }
  .details__list dd { margin: 0.35rem 0 0; }
  .pipeline ol { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1px; margin: 0; padding: 0; list-style: none; border-block: 1px solid currentColor; }
  .pipeline li { padding: 1.5rem 1rem 1.5rem 0; }
  .pipeline li + li { padding-left: 1rem; border-left: 1px solid currentColor; }
  .pipeline h3 { margin: 0 0 0.75rem; font-size: 1.2rem; }
  .pipeline p { margin: 0; }
  .data-boundary { display: grid; grid-template-columns: minmax(0, 1fr) minmax(16rem, .7fr); gap: clamp(2rem, 8vw, 8rem); margin-top: clamp(5rem, 12vw, 10rem); padding-top: 1.25rem; border-top: 1px solid currentColor; }
  .data-boundary > div:first-child { max-width: 42rem; }
  .data-boundary__copy { max-width: 42rem; }
  .data-boundary__copy > p { margin-top: 0; }
  .data-boundary dl { margin: 2rem 0 0; }
  .data-boundary dl div { padding-block: 1rem; border-top: 1px solid currentColor; }
  .data-boundary dl div:last-child { border-bottom: 1px solid currentColor; }
  .data-boundary dt { font-size: .8rem; letter-spacing: .1em; text-transform: uppercase; }
  .data-boundary dd { margin: .35rem 0 0; }
  @media (max-width: 42rem) { .data-boundary { display: block; } .data-boundary__copy { margin-top: 2rem; } }
  @media (max-width: 42rem) {
    .signal { align-items: flex-start; flex-direction: column; }
    .signal span { transform: rotate(90deg); }
    .details { display: block; }
    .details__list { margin-top: 3rem; }
    .pipeline ol { display: block; }
    .pipeline li + li { padding-left: 0; border-top: 1px solid currentColor; border-left: 0; }
  }
  @media (prefers-reduced-motion: reduce) { .experiment__cursor { animation: none; } }
</style>
