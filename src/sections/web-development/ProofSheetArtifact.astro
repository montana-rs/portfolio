  .proof-tool__choose-line { position: relative; z-index: 1; display: flex; align-items: baseline; justify-content: space-between; padding-top: .45rem; border-top: 1px solid rgba(255, 145, 104, .45); color: #e5c6a8; font-size: .78rem; letter-spacing: .08em; }
  .proof-tool__choose-input { display: inline-flex; align-items: baseline; font-weight: 700; text-shadow: 0 0 4px rgba(229, 198, 168, .9), 0 0 10px rgba(229, 198, 168, .72), 0 0 20px rgba(229, 198, 168, .5), 0 0 34px rgba(229, 198, 168, .32); animation: proof-power-flicker var(--flicker-duration, 18s) ease-in-out infinite var(--flicker-delay, 0s); }
  .proof-tool__choose-tag { color: var(--earthsong-orange); font-size: .52rem; line-height: 1; letter-spacing: .12em; font-weight: 700; text-shadow: 0 0 4px rgba(255, 145, 104, .95), 0 0 10px rgba(255, 145, 104, .78), 0 0 20px rgba(255, 145, 104, .56), 0 0 34px rgba(255, 145, 104, .36); animation: proof-power-flicker var(--flicker-duration, 19s) ease-in-out infinite var(--flicker-delay, -1.7s); }
  .proof-tool__input-cursor { display: inline-block; width: .55ch; height: .82em; margin-left: .1ch; vertical-align: -.08em; background: currentColor; animation: proof-input-cursor 1s steps(1, end) infinite; }
  @keyframes proof-input-cursor { 50% { opacity: 0; } }
  @keyframes proof-bit-flicker {
    0%, 20%, 24%, 48%, 52%, 76%, 81%, 100% { opacity: 1; filter: brightness(1); }
    21%, 23%, 49%, 51%, 77%, 80% { opacity: .35; filter: brightness(.65); }
    22%, 50%, 79% { opacity: 1.08; filter: brightness(1.7); }
  }
  @keyframes proof-power-flicker {
    0%, 16%, 21%, 43%, 48%, 70%, 76%, 100% { opacity: 1; filter: brightness(1); text-shadow: 0 0 4px currentColor, 0 0 10px currentColor, 0 0 20px currentColor, 0 0 34px currentColor; }
    17%, 20%, 44%, 47%, 71%, 75% { opacity: .72; filter: brightness(.8); text-shadow: 0 0 2px currentColor, 0 0 5px currentColor, 0 0 10px currentColor, 0 0 18px currentColor; }
    18.5%, 45.5%, 73% { opacity: 1.08; filter: brightness(1.45); text-shadow: 0 0 6px currentColor, 0 0 16px currentColor, 0 0 30px currentColor, 0 0 52px currentColor; }
  }
  @keyframes proof-screen-aura {
    0%, 16%, 21%, 43%, 48%, 70%, 76%, 100% { opacity: .38; filter: blur(7px) brightness(1); }
    17%, 20%, 44%, 47%, 71%, 75% { opacity: .32; filter: blur(6px) brightness(.94); }
    18.5%, 45.5%, 73% { opacity: .26; filter: blur(5px) brightness(.88); }
  }
  .proof-tool button.proof-tool__choose:hover, .proof-tool button.proof-tool__choose:focus-visible { background-color: #17100c; border-color: #ffd0bb; filter: brightness(1.12); box-shadow: inset 0 0 0 1px #111, inset 0 0 22px rgba(255, 145, 104, .16), 0 0 10px rgba(255, 145, 104, .22), 0 5px 0 #050605, 0 8px 14px rgba(0, 0, 0, .45); }
  .proof-tool button.proof-tool__choose:active { transform: translateY(5px); filter: brightness(.9); border-color: #a84d32; box-shadow: inset 0 0 0 1px #111, inset 0 0 12px rgba(255, 145, 104, .18), 0 1px 0 #050605, 0 2px 4px rgba(0, 0, 0, .36); }
  .proof-tool button:disabled { opacity: .4; cursor: not-allowed; }
  .proof-tool__controls { border-top: 1px solid var(--line); padding: 1rem 0; display: flex; flex-wrap: wrap; align-items: center; gap: 1rem; }
  .proof-tool__controls label { display: flex; align-items: center; gap: .5rem; }
  .proof-tool__controls input { width: 7rem; border: 1px solid var(--line); background: transparent; color: inherit; padding: .65rem; font: inherit; }
  .proof-tool__controls p { flex: 1 1 100%; margin: 0; color: var(--muted); }
  .proof-tool__result { display: grid; justify-items: start; border-top: 1px solid var(--line); padding: 1rem 0 0; }
  .proof-tool__result:empty { display: none; }
  .proof-tool__result :global(img) { display: block; width: min(100%, 48rem); max-width: 100%; height: auto; margin: 0 0 1rem; border: 1px solid var(--line); }
