  .proof-tool button:hover, .proof-tool button:focus-visible { background: var(--accent); color: var(--background); transform: translate(1px, 1px); box-shadow: 2px 2px 0 currentColor; }
  .proof-tool button:active { transform: translate(3px, 3px); box-shadow: none; }
  .proof-tool button.proof-tool__choose { position: relative; isolation: isolate; display: inline-flex; flex-direction: column; align-items: stretch; justify-content: flex-start; gap: .2rem; appearance: none; min-width: 13rem; min-height: 6rem; padding: .7rem .8rem .65rem; border: 2px solid var(--earthsong-orange); border-radius: .15rem; background: #080a07; color: #e5c6a8; text-align: left; box-shadow: inset 0 0 0 1px #111, inset 0 0 18px rgba(255, 145, 104, .08), 0 0 0 1px #050605, 0 5px 0 #050605, 0 8px 14px rgba(0, 0, 0, .45); transition: transform 80ms ease, box-shadow 80ms ease, filter 80ms ease; }
  .proof-tool button.proof-tool__choose::before { content: ''; position: absolute; z-index: -1; inset: .25rem; border: 1px solid rgba(229, 198, 168, .45); pointer-events: none; }
  .proof-tool button.proof-tool__choose::after { content: ''; position: absolute; z-index: -1; inset: -.3rem; border: 1px solid var(--earthsong-orange); border-radius: .35rem; background: transparent; opacity: .38; filter: blur(7px); box-shadow: 0 0 18px rgba(255, 145, 104, .9), 0 0 42px rgba(255, 145, 104, .52); pointer-events: none; animation: proof-screen-aura var(--flicker-duration, 18s) ease-in-out infinite var(--flicker-delay, 0s); }
  .proof-tool__choose-background { position: absolute; z-index: 0; inset: .7rem; display: grid; grid-template-columns: repeat(24, 1fr); grid-template-rows: repeat(9, 1fr); gap: 0; opacity: .32; pointer-events: none; }
  .proof-tool__choose-background :global(b) { display: block; width: auto; height: auto; background: transparent; }
  .proof-tool__choose-background :global(b.is-on) { background: var(--earthsong-orange); box-shadow: 0 0 3px rgba(255, 145, 104, .8); }
  .proof-tool__choose-glyphs { position: relative; z-index: 1; display: grid; grid-template-columns: repeat(36, 4px); grid-template-rows: repeat(3, 4px); gap: 1px; min-height: 1.3rem; color: #fff7ea; font-family: var(--font-micro); font-size: 1.15rem; line-height: 1; filter: contrast(1.8); text-shadow: 0 0 8px rgba(255, 247, 234, .95), 0 0 18px rgba(255, 247, 234, .9), 0 0 32px rgba(255, 247, 234, .78), 0 0 50px rgba(255, 247, 234, .58); }
