  .proof-tool__intro p:last-child { max-width: 34rem; color: var(--muted); }
  .proof-tool__workspace { margin-top: 2rem; border: 1px solid var(--line); background: var(--surface); overflow: visible; }
  .proof-tool__drop { min-height: 25rem; padding: clamp(1.25rem, 5vw, 4rem) 0; display: grid; align-content: center; gap: 1rem; }
  .proof-tool__drop.is-armed { box-shadow: inset 0 0 0 3px var(--accent); }
  .proof-tool__drop.is-working { opacity: .7; }
