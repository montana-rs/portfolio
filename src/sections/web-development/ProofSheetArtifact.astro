<section class="proof-tool" data-proof-sheet aria-label="Proof Sheet working artifact">
  <div class="proof-tool__intro">
    <p class="eyebrow">Working artifact</p>
    <p>Drop, paste, or choose an image. <br> The image stays in the browser; <br> OWLv2 model weights download remotely on first use.</p>
  </div>

  <div class="proof-tool__workspace">
    <div class="proof-tool__drop" data-proof-drop aria-describedby="proof-hint">
      <p class="proof-tool__mark">PROVENANCE / 00</p>
      <p class="proof-tool__drop-title">DROP<br /><em>ANYTHING.</em></p>
      <p id="proof-hint" class="proof-tool__hint">DROP, PASTE, OR CHOOSE ONE IMAGE<br />IMAGE STAYS IN BROWSER // OWLv2 WEIGHTS DOWNLOAD ON FIRST USE</p>
      <input data-proof-file type="file" accept="image/*" hidden />
      <button class="proof-tool__choose" data-proof-choose type="button" aria-label="Choose image">
        <span class="proof-tool__choose-background" data-proof-background aria-hidden="true"></span>
        <span class="proof-tool__choose-glyphs" data-proof-glyphs aria-hidden="true"></span>
        <span class="proof-tool__choose-line"><span class="proof-tool__choose-input"><span data-proof-input aria-hidden="true"></span><span class="proof-tool__input-cursor" data-proof-input-cursor aria-hidden="true"></span></span><span class="proof-tool__choose-tag" aria-hidden="true">00 // LOCAL</span></span>
      </button>
    </div>

    <div class="proof-tool__controls">
      <label for="proof-seed">SEED <input id="proof-seed" data-proof-seed inputmode="numeric" /></label>
      <button data-proof-recompose type="button" disabled>RECOMPOSE</button>
      <p data-proof-status aria-live="polite">READY // AWAITING INPUT</p>
    </div>
    <div class="proof-tool__result" data-proof-result></div>
  </div>
</section>

<script>
  import { initProofSheet } from './proof-sheet/runtime';
  initProofSheet();
</script>

<script>
  let glyphTimers: number[] = [];
  const initProofInput = () => {
    const input = document.querySelector<HTMLElement>('[data-proof-input]');
    const glyphs = document.querySelector<HTMLElement>('[data-proof-glyphs]');
    const background = document.querySelector<HTMLElement>('[data-proof-background]');
    if (!input || !glyphs || !background || input.dataset.ready) return;
    input.dataset.ready = 'true';
    const flickerLine = input.closest<HTMLElement>('.proof-tool__choose-line');
    const flickerButton = input.closest<HTMLElement>('.proof-tool__choose');
    const flickerDuration = `${(14 + Math.random() * 10).toFixed(2)}s`;
    const flickerDelay = `${(-Math.random() * 5).toFixed(2)}s`;
    flickerLine?.style.setProperty('--flicker-duration', flickerDuration);
    flickerLine?.style.setProperty('--flicker-delay', flickerDelay);
    flickerButton?.style.setProperty('--flicker-duration', flickerDuration);
    flickerButton?.style.setProperty('--flicker-delay', flickerDelay);
    const randomizeBit = (bit: HTMLElement) => {
      bit.classList.toggle('is-on', Math.random() > .48);
    };
    const scheduleBit = (bit: HTMLElement) => {
      if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
      const timer = window.setTimeout(() => {
        randomizeBit(bit);
        const interval = window.setInterval(() => randomizeBit(bit), 1000);
        glyphTimers.push(interval);
      }, Math.random() * 1000);
      glyphTimers.push(timer);
    };
    const generateGlyphs = () => {
      glyphs.replaceChildren();
      background.replaceChildren();
      for (let index = 0; index < 216; index += 1) {
        const backgroundBit = document.createElement('b');
        randomizeBit(backgroundBit);
        background.append(backgroundBit);
        scheduleBit(backgroundBit);
      }

      for (let index = 0; index < 108; index += 1) {
        const bit = document.createElement('b');
        randomizeBit(bit);
        bit.style.setProperty('--bit-duration', `${(2.1 + Math.random() * 3.8).toFixed(2)}s`);
        bit.style.setProperty('--bit-delay', `${(-Math.random() * 5.8).toFixed(2)}s`);
        glyphs.append(bit);
        scheduleBit(bit);
      }
    };
    glyphTimers.forEach((timer) => {
      window.clearTimeout(timer);
      window.clearInterval(timer);
    });
    glyphTimers = [];
    generateGlyphs();
    const text = 'INPUT';
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
      input.textContent = text;
      return;
    }
    let index = 0;
    window.setTimeout(() => {
      const typeNext = () => {
        input.textContent = text.slice(0, index);
        index += 1;
        if (index <= text.length) window.setTimeout(typeNext, 100);
      };
      typeNext();
    }, 900);
  };
  initProofInput();
  document.addEventListener('astro:page-load', initProofInput);
</script>

<style>
